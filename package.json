{
  "name": "resource-directory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "postinstall": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:verify": "tsx --conditions=react-server scripts/verify-database.ts",
    "auth:verify": "tsx --conditions=react-server scripts/verify-admin-login.ts",
    "mail:verify": "tsx --conditions=react-server scripts/verify-invitation-smtp.ts",
    "test": "vitest run",
    "test:db": "tsx --conditions=react-server scripts/run-database-tests.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "17.4.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "prettier": "^3.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
