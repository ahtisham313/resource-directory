# Copy to .env for local Docker Compose. This file contains placeholders only.
# Local PostgreSQL only: never copy these credentials to Railway.
POSTGRES_DB=resource_directory
POSTGRES_USER=resource_user
# Replace with a unique random password. Hexadecimal avoids URL escaping issues.
POSTGRES_PASSWORD=replace-with-a-random-local-password

# Use the same local password below, URL-encoded.
DATABASE_URL=postgresql://resource_user:replace-with-a-random-local-password@127.0.0.1:5433/resource_directory?schema=public

# Seeding is explicit. Choose a unique password (12+ characters, at most 72 bytes).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Directory Administrator

# Generate a unique random secret (at least 32 bytes); never share it between environments.
AUTH_SECRET=
# NextAuth v4 needs the canonical app URL, including https:// on Railway.
NEXTAUTH_URL=http://localhost:3000

# Optional private S3-compatible bucket. Required only for image uploads.
# Railway uses virtual-hosted URLs; copy endpoint/bucket/region from bucket credentials.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional private/self-hosted Nominatim-compatible search endpoint; no public default.
# Without it, approval reuses trusted address coordinates or asks for manual coordinates.
GEOCODING_ENDPOINT=
GEOCODING_USER_AGENT=

# Required for sending administrator invitations. Other features work without SMTP.
# Use the mail provider's host, port, and TLS settings; do not commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# If omitted, an email address in SMTP_USER is used as the sender.
SMTP_FROM=directory@example.com
# Invitation links use NEXTAUTH_URL above (canonical HTTPS URL in production).

# Railway supplies PORT itself. GitHub Railway tokens belong in GitHub secrets.
